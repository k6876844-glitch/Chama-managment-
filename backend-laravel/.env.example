APP_NAME="Chama API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chama
DB_USERNAME=root
DB_PASSWORD=

# Members are the users of this system, so Laravel's auth uses the Member model
AUTH_MODEL=App\Models\Member

SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# First chairperson account, created by: php artisan db:seed
ADMIN_NAME="Chama Chairperson"
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=changeme123
